# Copy to .env to change a setting; every one has a default. Never commit .env.

# Where the emotion model runs: `local` (the default) on this machine, which needs
# `uv sync --extra local-model`; or `hugging_face`, behind the Hugging Face API.
EMOTION_BACKEND=local

# Hugging Face access token (https://huggingface.co/settings/tokens), needed only with
# EMOTION_BACKEND=hugging_face. Calls spend the account's inference credit.
HF_TOKEN=

# Where each run's snapshot (image + metadata) is written.
OUTPUTS_DIR=outputs
